# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# Writer mode: auto (live AI if configured, else offline) | offline | llm | bad (checker demo only)
T3_WRITER=auto
# OpenAI-compatible endpoint, e.g. DeepSeek or Qwen/DashScope
T3_LLM_BASE_URL=
T3_LLM_API_KEY=
T3_LLM_MODEL=
T3_LLM_TIMEOUT=30
# Web app port
T3_PORT=8803
